# ── AIVORY Console — Environment Variables ────────────────────────────────────
# Copy this to .env (development) or .env.production (VPS) and fill in values.

# Backend API base URL
# Development:  http://localhost:8081
# Production:   https://backend.aivory.id
NEXT_PUBLIC_API_URL=https://backend.aivory.id

# VPS Bridge (internal gateway)
VPS_BRIDGE_URL=http://localhost:3003

# n8n editor base URL
NEXT_PUBLIC_N8N_EDITOR_BASE_URL=http://localhost:5678

# Composio OAuth (manages all OAuth providers + app connections)
# Get your API key from https://app.composio.dev → Settings
COMPOSIO_API_KEY=your-composio-api-key
COMPOSIO_REDIRECT_URL=https://dashboard.aivory.id/integrations/callback
